@model List<Locally.Models.Location>

<h2 class="mb-4">My Locations</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Hidden Gem</a>
</p>

@if (!Model.Any())
{
    <p>You have not added any locations yet.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
        <tr>
            <th>Name</th>
            <th>City</th>
            <th>Category</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (Locally.Models.Location location in Model)
        {
            <tr>
                <td>@location.Name</td>
                <td>@location.City</td>
                <td>@location.Category</td>
                <td>@location.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@location.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@location.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}